# Copy this file to .env.local and fill it in. Never commit .env.local.

# Browser key for Google Places autocomplete.
# Restrict it in Google Cloud to: Places API (New) only, and HTTP referrers
# http://localhost:3000/* plus your deployed address (e.g. https://your-app.vercel.app/*).
# Leave empty to use the built-in list of cities instead of Google search.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
